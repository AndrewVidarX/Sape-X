			if ragdolls[player.Name] then
				ragdolls[player.Name]:init(character)
			end

			if balls[player] then
				balls[player]:DoCleaning()
				balls[player] = localMaid
			end

			if (config.Weather.Value == "Rain" or config.Weather.Value == "Snow") and character.Head:FindFirstChild("Air") then
				character.Head.Air.ParticleEmitter.Enabled = true
			elseif config.Weather.Value ~= "Rain" and config.Weather.Value ~= "Snow" and character.Head:FindFirstChild("Air") then
				character.Head.Air.ParticleEmitter.Enabled = false
			end

			if boots:FindFirstChild(profile.inventory.Current.Boots.Value) then
				for _,v in next, rightBoot:GetChildren() do
					if v and v:IsA("SurfaceAppearance") then
						v:Destroy()
					end
				end

				for _,v in next, leftBoot:GetChildren() do
					if v and v:IsA("SurfaceAppearance") then
						v:Destroy()
					end
				end

				rightBoot.TextureID = boots[profile.inventory.Current.Boots.Value].TextureID
				leftBoot.TextureID = boots[profile.inventory.Current.Boots.Value].TextureID

				if boots[profile.inventory.Current.Boots.Value]:FindFirstChild("SurfaceAppearance") then
					boots[profile.inventory.Current.Boots.Value].SurfaceAppearance:Clone().Parent = rightBoot
					boots[profile.inventory.Current.Boots.Value].SurfaceAppearance:Clone().Parent = leftBoot
				end
			end

			if (_G._references.Main.captains:FindFirstChild("home") and _G._references.Main.captains.home.Value == player.Name) or (_G._references.Main.captains:FindFirstChild("away") and _G._references.Main.captains.away.Value == player.Name) then
				local armband = _G._references.Main.storage.Captain:Clone()
				armband.Parent = character
				armband.Weld.Part1 = leftUpperArm
			end

			if gloves:FindFirstChild(profile.inventory.Current.Gloves.Value) then
