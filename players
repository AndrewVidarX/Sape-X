													_G._references.RemoteEvent:FireClient(player, "kick", reason)
													ban(player, reason)
												end
											end
										else
											limbsChecked += 1
										end
									end
								end
							end

							if limbsChecked ~= 21 then
								handshakeData[player.Name].banFlags += 2
								if handshakeData[player.Name].banFlags >= 5 then
									local reason = "Hitbox Check Failed"
									if player:IsDescendantOf(_G._services.Players) == true then
										_G._references.RemoteEvent:FireClient(player, "kick", reason)
										ban(player, reason)
									end
								end
							end

							if handshakeData[player.Name].cipher ~= response.key then
								local reason = "Handshake Tampering"
								if player:IsDescendantOf(_G._services.Players) == true then
									_G._references.RemoteEvent:FireClient(player, "kick", reason)
									ban(player, reason)
								end
							end

							if handshakeData[player.Name].flags > 0 then
								handshakeData[player.Name].flags -= 1
							end
							if handshakeData[player.Name].banFlags > 0 then
								handshakeData[player.Name].banFlags -= 1
							end
						end)

						if not success then
							handshakeData[player.Name].flags += 1
							if handshakeData[player.Name].flags > 10 then
								if player:IsDescendantOf(_G._services.Players) == true then
									player:Kick("Handshake Disconnection: Rejoin")
								end
							end
						end
					end
				end
			end
		end)

		task.spawn(function()
			while true do
				for index, data in next, cache do
					if not _G._services.Players:FindFirstChild(index) then
						cache[index] = nil
					end
				end

				for _, player in next, _G._services.Players:GetPlayers() do
					if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and _G._references.Main.config.AutoSystem.Value then
						local rootPart = player.Character:WaitForChild("HumanoidRootPart", 100)

						if rootPart and rootPart.Parent then
							if not cache[player.Name] then
								cache[player.Name] = {
									position = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z),
									Yposition = Vector3.new(0, rootPart.Position.Y, 0),
									rootPart = rootPart,
									flags = 0,
									inStore = false
								}
							end

							local overlapParams = OverlapParams.new()
							overlapParams.FilterType = Enum.RaycastFilterType.Include
							overlapParams.FilterDescendantsInstances = {player.Character}

							for _, part in next, workspace:GetPartBoundsInBox(workspace.game.regions.store.CFrame, workspace.game.regions.store.Size, overlapParams) do
								if part and part.Parent then
									cache[player.Name].inStore = true
									break
								end
							end

							local difference = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - cache[player.Name].position).Magnitude
							local Ydifference = (Vector3.new(0, rootPart.Position.Y, 0) - cache[player.Name].Yposition).Magnitude

							if (difference > 24 and difference <= 30) and not player:FindFirstChild("Teleport") and cache[player.Name].rootPart == rootPart and cache[player.Name].inStore == false then
								cache[player.Name].flags += 1
								--player.Character:SetPrimaryPartCFrame(CFrame.new(cache[player.Name].position))
								cache[player.Name] = {
									position = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z),
									Yposition = Vector3.new(0, rootPart.Position.Y, 0),
									rootPart = rootPart,
									flags = cache[player.Name].flags,
									inStore = false
								}
							elseif (difference > 30 or Ydifference > 10) and not player:FindFirstChild("Teleport") and cache[player.Name].rootPart == rootPart and cache[player.Name].inStore == false then
								cache[player.Name].flags += 2
								--[[local teleport = Instance.new("BoolValue", player)
								teleport.Name = "Teleport"
								teleport.Value = true
								_G._services.Debris:AddItem(teleport, 0.015)]]
								player.Character:SetPrimaryPartCFrame(CFrame.new(cache[player.Name].position))
								cache[player.Name] = {
									position = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z),
									Yposition = Vector3.new(0, rootPart.Position.Y, 0),
									rootPart = rootPart,
									flags = cache[player.Name].flags,
									inStore = false
								}
							else
								if cache[player.Name].flags > 0 then
									cache[player.Name].flags -= 1
								end

								cache[player.Name] = {
									position = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z),
									Yposition = Vector3.new(0, rootPart.Position.Y, 0),
									rootPart = rootPart,
									flags = cache[player.Name].flags,
									inStore = false
								}
							end

							if cache[player.Name].flags >= 7 then
								player:Kick("RF GUARD // Anti Teleport Check: Stop Cheating or Check Your Internet Connection")
								cache[player.Name] = nil
							end
						end
					elseif player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and not _G._references.Main.config.AutoSystem.Value and cache[player.Name] then
						cache[player.Name] = nil
					end
				end

				task.wait(1)
			end
		end)

		-- Setting up original limb sizes
		task.spawn(function()
			for i, limb in pairs(_G._services.StarterPlayer.StarterCharacter:GetChildren()) do
				if limb:IsA("BasePart") then
					for i, v in pairs(limbs) do
						if string.match(limb.Name, v) then
							local dictionaryVector = {limb.Size.X, limb.Size.Y, limb.Size.Z}
							originalLimbSizes[limb.Name] = dictionaryVector
						end
					end
				end
			end
		end)
	end,
}
