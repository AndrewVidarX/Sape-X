					updateAccessories(profile, character)
				end)
			end

			jersey.name.Text = string.upper(player.Name)
			jersey.number.Text = tostring(profile.stats.Number.Value)

			if handle.Transparency == 1 then
				weld.C0 = offsetData.Classic.Value
			else
				weld.C0 = offsetData.Layered.Value
			end

			--[[  Anti Infinite Jump  ]]---------------------------------------------------------------------------------------------------

			local maxJumps = 7
			local timeFrame = 2.5
			local playerJumps = {}

			localMaid["jumping"] = humanoid.Jumping:Connect(function()
				if not playerJumps[player] then
					playerJumps[player] = {count = 0, time = tick()}
				end

				local playerData = playerJumps[player]
				local currentTime = tick()

				if (currentTime - playerData.time) > timeFrame then
					playerData.count = 0
					playerData.time = currentTime
				end

				playerData.count = playerData.count + 1

				if playerData.count > maxJumps then
					player:Kick("RF GUARD | Infinite Jump Detected")
				end
			end)

