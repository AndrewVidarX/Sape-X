			end

			local appearanceModel = nil

			local success, errorMessage = pcall(function()
				appearanceModel = _G._services.Players:GetCharacterAppearanceAsync(player.UserId)
			end)

			if not success then
				warn(string.format("AppearanceInitializer | error while loading character appearance of user %s, retrying appearance loading (%s)", tostring(player.UserId), errorMessage))

				local newSuccess, newErrorMessage = pcall(function()
					appearanceModel = _G._services.Players:GetCharacterAppearanceAsync(player.UserId)
				end)

				if not newSuccess then
					warn(string.format("AppearanceInitializer | appearance loading retry failed for user %s (%s)", tostring(player.UserId), newErrorMessage))
				end
			else
				warn(string.format("AppearanceInitializer | loaded character appearance of user %s", tostring(player.UserId)))
			end

			while not character:FindFirstChild("Humanoid") do
