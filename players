		local function updateAccessories(profile, character)
			character.Accessories:ClearAllChildren()
			character.RightHand.Transparency = 0
			character.LeftHand.Transparency = 0

			for index = 1, 3 do
				if accessories:FindFirstChild(profile.inventory.Current["Accessory " .. tostring(index)].Value) then
					local accessory = accessories:WaitForChild(profile.inventory.Current["Accessory " .. tostring(index)].Value, 100)

					local function addAccessory(object)
						if object:FindFirstChild("Part1") and object:FindFirstChild("Weld") and character:FindFirstChild(object.Part1.Value) then
							local meshPart = object:Clone()
							meshPart.Parent = character.Accessories
							meshPart.Weld.Part1 = character:WaitForChild(object.Part1.Value, 100)

							for _, folder in next, character.Gloves:GetChildren() do
								for _, glove in next, folder:GetChildren() do
									if glove.Transparency == 0 and string.find(meshPart.Name, "Glove") then
										meshPart.Transparency = 1
									elseif glove.Transparency == 1 and string.find(meshPart.Name, "Glove") then
										character.RightHand.Transparency = 1
										character.LeftHand.Transparency = 1
									elseif glove.Transparency == 1 and not character.Accessories:FindFirstChild("RightGlove") then
										character.RightHand.Transparency = 0
										character.LeftHand.Transparency = 0
									end
								end
							end
						end
					end

					if accessory:IsA("Model") then
						for _, object in next, accessory:GetChildren() do
							if object then
								addAccessory(object)
							end
						end
					else
						addAccessory(accessory)
					end
				end
			end
		end

		local function updateGloves(profile, gloves, character)
			local reference = gloves:WaitForChild(profile.inventory.Current.Gloves.Value, 100)
			local folder = character:WaitForChild("Gloves", 100)

			if tonumber(reference.GloveType.Value) == 1 then
				folder["2"].RightGlove.Transparency = 1
				folder["2"].LeftGlove.Transparency = 1

				if folder["1"].RightGlove:FindFirstChild("SurfaceAppearance") then
					folder["1"].RightGlove.SurfaceAppearance:Destroy()
				end
				if folder["1"].LeftGlove:FindFirstChild("SurfaceAppearance") then
					folder["1"].LeftGlove.SurfaceAppearance:Destroy()
				end

				reference.SurfaceAppearance:Clone().Parent = folder["1"].RightGlove
				reference.SurfaceAppearance:Clone().Parent = folder["1"].LeftGlove

				if character.RightHand.Transparency == 1 then
					if character.Accessories:FindFirstChild("RightGlove") and character.Accessories.RightGlove.Transparency == 1 then
						folder["1"].RightGlove.Transparency = 0
						folder["1"].LeftGlove.Transparency = 0
					elseif character.Accessories:FindFirstChild("RightGlove") and character.Accessories.RightGlove.Transparency == 0 then
						folder["1"].RightGlove.Transparency = 1
						folder["1"].LeftGlove.Transparency = 1
					else
						folder["1"].RightGlove.Transparency = 0
						folder["1"].LeftGlove.Transparency = 0
					end
				else
					folder["1"].RightGlove.Transparency = 1
					folder["1"].LeftGlove.Transparency = 1
				end

			elseif tonumber(reference.GloveType.Value) == 2 then
				folder["1"].RightGlove.Transparency = 1
				folder["1"].LeftGlove.Transparency = 1

				if folder["2"].RightGlove:FindFirstChild("SurfaceAppearance") then
					folder["2"].RightGlove.SurfaceAppearance:Destroy()
				end
				if folder["2"].LeftGlove:FindFirstChild("SurfaceAppearance") then
					folder["2"].LeftGlove.SurfaceAppearance:Destroy()
				end

				reference.SurfaceAppearance:Clone().Parent = folder["2"].RightGlove
				reference.SurfaceAppearance:Clone().Parent = folder["2"].LeftGlove

				if character.RightHand.Transparency == 1 then
					if character.Accessories:FindFirstChild("RightGlove") and character.Accessories.RightGlove.Transparency == 1 then
						folder["2"].RightGlove.Transparency = 0
						folder["2"].LeftGlove.Transparency = 0
					elseif character.Accessories:FindFirstChild("RightGlove") and character.Accessories.RightGlove.Transparency == 0 then
						folder["2"].RightGlove.Transparency = 1
						folder["2"].LeftGlove.Transparency = 1
					else
						folder["2"].RightGlove.Transparency = 0
						folder["2"].LeftGlove.Transparency = 0
					end
				else
					folder["2"].RightGlove.Transparency = 1
					folder["2"].LeftGlove.Transparency = 1
				end
			end
		end

		local function characterAdded(player, character)
			while not character:FindFirstChild("Humanoid") and not character:FindFirstChild("Head") do
