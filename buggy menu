function config:hover(frame)
	if script:GetAttribute("freeze") then
		return
	end

	for _, container in next, menu.menu.main.tabs:GetChildren() do
		if container and container:IsA("Frame") then
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("main") and newFrame.main:FindFirstChild("button") and newFrame ~= frame then
					if newFrame.main:FindFirstChild("icon") then
						services.TweenService:Create(newFrame.main.icon.icon, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {ImageColor3 = Color3.fromRGB(35, 39, 50)}):Play()
					end

					services.TweenService:Create(newFrame.main, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0}):Play()
					services.TweenService:Create(newFrame.main.gfx.gfx, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {ImageTransparency = 1}):Play()
					services.TweenService:Create(newFrame.main.label, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(35, 39, 50)}):Play()
					services.TweenService:Create(newFrame.main.description, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(35, 39, 50)}):Play()
					services.TweenService:Create(newFrame.main.UIScale, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Scale = 1}):Play()
					services.TweenService:Create(newFrame.main.label, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(35, 39, 50), Position = UDim2.new(0, 15, 0, 10)}):Play()
					services.TweenService:Create(newFrame.main.label.shadow, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = UDim2.new(0, 0, 0, 0)}):Play()
					services.TweenService:Create(newFrame.main.description, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(35, 39, 50), Position = UDim2.new(0, 15, 0, 60)}):Play()
