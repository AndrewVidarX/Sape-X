function config:update(container, frame)
	self.navigation.container = container.Name
	self.navigation.current = frame.Name
	self.navigation.horizontal = frame.alignment.horizontal.Value
	self.navigation.vertical = frame.alignment.vertical.Value
end

function config:move(direction)
	if direction == "right" and self.navigation.container and self.navigation.current then
		local container = menu.menu.main.tabs[self.navigation.container]
		local frame = container[self.navigation.current]
		local alignment = frame.alignment
		local nextFrameFound = false

		if alignment.horizontal.Value == "left" then
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical and newFrame.alignment.horizontal.Value == "right" and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end
		end
	elseif direction == "left" and self.navigation.container and self.navigation.current then
		local container = menu.menu.main.tabs[self.navigation.container]
		local frame = container[self.navigation.current]
		local alignment = frame.alignment
		local nextFrameFound = false

		if alignment.horizontal.Value == "right" then
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical and newFrame.alignment.horizontal.Value == "left" and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end

			if not nextFrameFound then
				for _, newFrame in next, container:GetChildren() do
					if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == 1 and newFrame.alignment.horizontal.Value == "left" and not nextFrameFound then
						nextFrameFound = true
						self:update(container, newFrame)
						self:hover(newFrame)
						break
					end
				end
			end
		end
	elseif direction == "up" and self.navigation.container and self.navigation.current then
		local container = menu.menu.main.tabs[self.navigation.container]
		local frame = container[self.navigation.current]
		local alignment = frame.alignment
		local nextFrameFound = false

		if alignment.horizontal.Value == "middle" then
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical - 1 and newFrame.alignment.horizontal.Value == "left" and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end
		else
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical - 1 and newFrame.alignment.horizontal.Value == alignment.horizontal.Value and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end

			if not nextFrameFound then
				for _, newFrame in next, container:GetChildren() do
					if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical - 1 and newFrame.alignment.horizontal.Value == "middle" and not nextFrameFound then
						nextFrameFound = true
						self:update(container, newFrame)
						self:hover(newFrame)
						break
					end
				end
			end
		end
	elseif direction == "down" and self.navigation.container and self.navigation.current then
		local container = menu.menu.main.tabs[self.navigation.container]
		local frame = container[self.navigation.current]
		local alignment = frame.alignment
		local nextFrameFound = false

		if alignment.horizontal.Value == "middle" then
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical + 1 and newFrame.alignment.horizontal.Value == "left" and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end
		else
			for _, newFrame in next, container:GetChildren() do
				if newFrame and newFrame:IsA("Frame") and newFrame:FindFirstChild("alignment") and newFrame.alignment.vertical.Value == self.navigation.vertical + 1 and newFrame.alignment.horizontal.Value == alignment.horizontal.Value and not nextFrameFound then
					nextFrameFound = true
					self:update(container, newFrame)
					self:hover(newFrame)
					break
				end
			end
		end
	end
end

function config:select(frame)
	if not self.cache["buttonDebounce"] and self.current ~= frame.Name then
		self.cache["buttonDebounce"] = true

		if self.bulkFadeGroups[self.current] then
			self.bulkFadeGroups[self.current]:FadeOut()
		end

		self.current = frame.Name
		menu.menu.main.tabs.UIPageLayout:JumpTo(menu.menu.main.tabs[frame.Name])

		task.wait(0.1)

		if self.bulkFadeGroups[frame.Name] then
			self.bulkFadeGroups[frame.Name]:FadeIn()
		end

		if services.UserInputService.GamepadEnabled then
			for _,v in next, menu.menu.main.tabs[frame.Name]:GetChildren() do
				if v and v:IsA("Frame") and v.LayoutOrder == 1 and v:FindFirstChild("alignment") then
					self.navigation.container = frame.Name
					self.navigation.current = v.Name
					self.navigation.horizontal = v.alignment.horizontal.Value
					self.navigation.vertical = v.alignment.vertical.Value
					self:hover(v)
				end
			end
		end

		self.cache["buttonDebounce"] = nil
	end
end

function config:init()
	--[[  Appearance  ]]-------------------------------------------------

	local rig = references.Main.rigs.Character:Clone()

	local success, appearanceModel = pcall(function()
		return _G._services.Players:GetCharacterAppearanceAsync(localPlayer.UserId)
	end)

	if success and appearanceModel then
		for _,v in next, appearanceModel:GetChildren() do
			if v:IsA("Accessory") and not v:FindFirstChildWhichIsA("WrapLayer", true) and not v:FindFirstChild("BodyBackAttachment", true) and not v:FindFirstChild("WaistBackAttachment", true) then
				v.Parent = rig
			elseif v:IsA("BodyColors") then
				rig["Body Colors"]:Destroy()
				v.Parent = rig
			elseif v:IsA("Decal") and v.Name == "face" then
				rig.Head.face.Texture = v.Texture
			end
		end
	end

	if references.Main.boots:FindFirstChild(references.Profile.inventory.Current.Boots.Value) then
		rig.RightBoot.TextureID = references.Main.boots[references.Profile.inventory.Current.Boots.Value].TextureID
		rig.LeftBoot.TextureID = references.Main.boots[references.Profile.inventory.Current.Boots.Value].TextureID
	end

	menu.menu.Visible = true
	rig.Parent = workspace.game.menu
	rig:SetPrimaryPartCFrame(workspace.game.menu.character.menu.CFrame)
	coreGui:SetCoreGui("SetCoreGuiEnabled", "Chat", false)

	local mesh = references.Main.balls["Adidas RF Pro 23/24"]:Clone()
	mesh.Parent = rig.Ball.design
	mesh.Size = rig.Ball.Size
	mesh.CFrame = rig.Ball.CFrame
	rig.Ball.Transparency = 1

	local weld = Instance.new("WeldConstraint", mesh)
	weld.Part0 = mesh
	weld.Part1 = rig.Ball

	local idle = rig.Humanoid.Animator:LoadAnimation(references.Main.animations.Player.Menu)
	idle:Play()

	--[[  Kits  ]]-------------------------------------------------

	local function loadKit(kits)
		if kits:FindFirstChildWhichIsA("Shirt") then
			for _,v in next, rig:GetChildren() do
				if v:IsA("Shirt") or v:IsA("Pants") then
					v:Destroy()
				end
			end

			if rig:FindFirstChild("LayeredShirt") then
				rig.LayeredShirt.Handle.Transparency = 1
				rig.LayeredShirt.Handle.AccessoryWrapLayer.Enabled = false
			end

			if rig:FindFirstChild("LayeredPants") then
				rig.LayeredPants.Handle.Transparency = 1
				rig.LayeredPants.Handle.AccessoryWrapLayer.Enabled = false
			end

			if string.find(localPlayer.Team.Name, "GK") and kits:FindFirstChild("GK Shirt") and kits:FindFirstChild("GK Pants") then
				kits["GK Shirt"]:Clone().Parent = rig
				kits["GK Pants"]:Clone().Parent = rig
			else
				kits.Shirt:Clone().Parent = rig
				kits.Pants:Clone().Parent = rig
			end
		else
			for _,v in next, rig:GetChildren() do
				if v:IsA("Shirt") or v:IsA("Pants") then
					v:Destroy()
				end
			end

			references.Main.storage.ClassicShirt:Clone().Parent = rig
			references.Main.storage.ClassicPants:Clone().Parent = rig
			rig.ClassicPants.Color3 = kits.PantsColour.Value

			if rig:FindFirstChild("LayeredShirt") then
				rig.LayeredShirt.Handle.Transparency = 0
				rig.LayeredShirt.Handle.AccessoryWrapLayer.Enabled = true
			end

			if string.find(localPlayer.Team.Name, "GK") and kits:FindFirstChild("GK Shirt") then
				if rig.LayeredShirt.Handle:FindFirstChildWhichIsA("SurfaceAppearance") then
					rig.LayeredShirt.Handle:FindFirstChildWhichIsA("SurfaceAppearance"):Destroy()
					kits["GK Shirt"]:Clone().Parent = rig.LayeredShirt.Handle
				end
			else
				if rig.LayeredShirt.Handle:FindFirstChildWhichIsA("SurfaceAppearance") then
					rig.LayeredShirt.Handle:FindFirstChildWhichIsA("SurfaceAppearance"):Destroy()
					kits.Shirt:Clone().Parent = rig.LayeredShirt.Handle
				end
			end
		end
	end

	local function updateKit()
		if string.find(localPlayer.Team.Name, "Home") then
			local kits = teamService:getKitFromTeam("Home")
			loadKit(kits)
		elseif string.find(localPlayer.Team.Name, "Away") then
			local kits = teamService:getKitFromTeam("Away")
			loadKit(kits)
		else
			for _,v in next, rig:GetChildren() do
				if v:IsA("Shirt") or v:IsA("Pants") then
					v:Destroy()
				end
			end

			rig.LayeredShirt.Handle.Transparency = 1
			rig.LayeredShirt.Handle.AccessoryWrapLayer.Enabled = false

			services.StarterPlayer.StarterCharacter.ClassicShirt:Clone().Parent = rig
			services.StarterPlayer.StarterCharacter.ClassicPants:Clone().Parent = rig
		end
	end

	localPlayer:GetPropertyChangedSignal("Team"):Connect(function()
		updateKit()
	end)

	for _, reference in next, {"Home", "Away"} do
		references.Main.config.Stats[reference].Team.Changed:Connect(updateKit)
		references.Main.config.Stats[reference]["Kit Type"].Changed:Connect(updateKit)
	end

	--[[  Bulk Fade  ]]-------------------------------------------------

	for _, frame in next, menu.menu.main.tabs:GetChildren() do
		if frame and frame:IsA("Frame") then
			self.bulkFadeGroups[frame.Name] = bulkFade.CreateGroup(frame:GetDescendants(), TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))

			if frame.Name ~= self.current then
				self.bulkFadeGroups[frame.Name]:FadeOut()
			end
		end
	end

	--[[  Toggle  ]]-------------------------------------------------

	local function toggleMenu()
		if not menu.Enabled then
			references.Main.sounds.UI.Click:Play()

			menu.Enabled = true
			menu.gradient:TweenPosition(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.InOut, Enum.EasingStyle.Quint, 0.5, true)

			task.wait(0.5)

			movementController:SetAttribute("forceStop", true)
			movementController:SetAttribute("canSprint", false)
			coreGui:SetCoreGui("SetCoreGuiEnabled", "Chat", false)

			main.Enabled = false
			menu.menu.Visible = true

			lerpValuePlay.Value = 0
			lerpValueCustomize.Value = 0

			rig.Parent = workspace.game.menu
			rig:SetPrimaryPartCFrame(workspace.game.menu.character.menu.CFrame)
			idle:Play(0)

			task.delay(0.1, function()
				for _, track in next, workspace.game.menu.Character.Humanoid.Animator:GetPlayingAnimationTracks() do
					if track and track ~= idle then
						track:Stop(0)
					end
				end
			end)

			script:SetAttribute("freeze", false)
			script:SetAttribute("enabled", true)

			currentCamera.FieldOfView = 30

			services.Lighting.DepthOfField.Enabled = true
			services.Lighting.DepthOfField.FarIntensity = 1
			services.Lighting.DepthOfField.FocusDistance = 0
			services.Lighting.DepthOfField.InFocusRadius = 50
			services.Lighting.DepthOfField.NearIntensity = 0

			task.wait(0.3)

			references.Main.sounds.Player.Woosh:Play()
			menu.gradient:TweenPosition(UDim2.new(1, 700, 0, 0), Enum.EasingDirection.InOut, Enum.EasingStyle.Quint, 0.5, true)

			task.wait(0.5)

			currentCamera.FieldOfView = 30
			menu.gradient.Position = UDim2.new(-1, -700, 0, 0)
		end
	end

	--[[  Console  ]]-------------------------------------------------

	menu.console.controls.back.Visible = false
	menu.console.controls.spin.Visible = false

	if services.UserInputService.GamepadEnabled then
		menu.console.Visible = true
	end

	services.UserInputService.GamepadConnected:Connect(function()
		menu.console.Visible = true
	end)

	services.UserInputService.GamepadDisconnected:Connect(function()
		menu.console.Visible = false
	end)

	services.UserInputService.InputBegan:Connect(function(inputObject, processedEvent)
		if inputObject.KeyCode == Enum.KeyCode.ButtonR1 and self.index[self.current] and script:GetAttribute("enabled") and not script:GetAttribute("freeze") and not self.tabs.debounce then
			self.tabs.debounce = true
			if self.index[self.current] == #menu.menu.main.buttons:GetChildren() - 1 then
				for page, index in next, self.index do
					if index and index == 1 then
						references.Main.sounds.UI.Click:Play()
						self:select(menu.menu.main.buttons[page])
						task.delay(0.2, function()
							self.tabs.debounce = false
						end)
						return
					end
				end
			else
				for page, index in next, self.index do
					if index and index == self.index[self.current] + 1 then
						references.Main.sounds.UI.Click:Play()
						self:select(menu.menu.main.buttons[page])
						task.delay(0.2, function()
							self.tabs.debounce = false
						end)
						return
					end
				end
			end
			task.delay(0.2, function()
				self.tabs.debounce = false
			end)
		elseif inputObject.KeyCode == Enum.KeyCode.ButtonL1 and self.index[self.current] and script:GetAttribute("enabled") and not script:GetAttribute("freeze") then
			self.tabs.debounce = true
			if self.index[self.current] == 1 then
				for page, index in next, self.index do
