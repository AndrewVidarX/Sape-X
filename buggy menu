	services.TweenService:Create(frame.main, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 1}):Play()
	services.TweenService:Create(frame.main.gfx.gfx, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {ImageTransparency = 0.3}):Play()
	services.TweenService:Create(frame.main.UIScale, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Scale = 1.03}):Play()

	if frame.main:FindFirstChild("icon") then
		services.TweenService:Create(frame.main.icon.icon, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	end

	if frame.main.label.TextXAlignment == Enum.TextXAlignment.Left then
		services.TweenService:Create(frame.main.label, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.new(0, 18, 0, 7)}):Play()
