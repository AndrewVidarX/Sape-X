	elseif frame.main.label.TextXAlignment == Enum.TextXAlignment.Right then
		services.TweenService:Create(frame.main.label, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.new(0, 12, 0, 7)}):Play()
