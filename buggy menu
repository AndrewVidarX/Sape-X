local function updateMenuScale()
	local camera = workspace.CurrentCamera
	if not camera then return end

	if UserInputService.TouchEnabled then
		local viewport = camera.ViewportSize

		local widthScale = viewport.X / 1366
		local heightScale = viewport.Y / 768

		menuScale.Scale = math.clamp(
			math.min(widthScale, heightScale) * 0.9,
			0.4,
			0.9
		)
	else
		menuScale.Scale = 1
	end
end

local function connectCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateMenuScale)
	end
	updateMenuScale()
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(connectCamera)

