		services.TweenService:Create(frame.main.description, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.new(0, 18, 0, 57)}):Play()
