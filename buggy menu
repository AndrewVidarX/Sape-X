	services.UserInputService.InputChanged:Connect(function(inputObject, processedEvent)
		if inputObject.KeyCode == Enum.KeyCode.Thumbstick1 and script:GetAttribute("enabled") and not script:GetAttribute("freeze") and self.navigation.current ~= "none" and self.navigation.container ~= "none" and not self.inputInProcess then
			self.inputInProcess = true

			if inputObject.Position.X >= 0.7 and not self.navigation.debounce then
				self.navigation.debounce = true
				self:move("right")
			elseif inputObject.Position.X <= -0.7 and not self.navigation.debounce then
				self.navigation.debounce = true
				self:move("left")
			elseif inputObject.Position.Y >= 0.7 and not self.navigation.debounce then
				self.navigation.debounce = true
				self:move("up")
			elseif inputObject.Position.Y <= -0.7 and not self.navigation.debounce then
				self.navigation.debounce = true
				self:move("down")
			elseif inputObject.Position.X < 0.3 and inputObject.Position.X > -0.3 and inputObject.Position.Y < 0.3 and inputObject.Position.Y > -0.3 and self.navigation.debounce then
				task.delay(0.1, function()
					self.navigation.debounce = false
				end)
			end

			task.delay(0.2, function()
				self.inputInProcess = false
			end)
