			local centre = Vector2.new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y / 2)
			local difference = mousePosition - centre
			local unit = Vector2.new((difference.Y / centre.Y) * cameraLimit, (difference.X / centre.X)*  cameraLimit)

			coreGui:SetCoreGui("SetCoreGuiEnabled", "Chat", false)
			currentCamera.CameraType = Enum.CameraType.Scriptable

			if not services.UserInputService.TouchEnabled and not services.UserInputService.GamepadEnabled then
				services.TweenService:Create(currentCamera, TweenInfo.new(delta, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {FieldOfView = 30, CFrame = workspace.game.menu.camera.menu.CFrame:Lerp(workspace.game.menu.camera.play.CFrame, lerpValuePlay.Value):Lerp(workspace.game.menu.camera.customize.CFrame, lerpValueCustomize.Value) * CFrame.Angles(-unit.X / divider, -unit.Y / divider, 0)}):Play()
			else
