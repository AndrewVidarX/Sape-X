local function stopAllSounds()
	local chantBaseHolder = game.ReplicatedStorage.game.sounds.RFL.ChantBase
	local chantsHolder = game.ReplicatedStorage.game.sounds.RFL.Chants

	for _,soundFolder in pairs(chantBaseHolder:GetChildren()) do
		local sound = soundFolder:FindFirstChildWhichIsA("Sound")

		if sound then
			sound:Stop()
		end
	end

	for _,soundFolder in pairs(chantsHolder:GetChildren()) do
		for _, sound in pairs(soundFolder:GetChildren()) do
			if sound:IsA("Sound") then
				sound:Stop()
			end
		end
	end
end

