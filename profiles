function Profiles._playerRemoved(_player : Player)
	if Profiles._maids[_player.Name] then
		Profiles._maids[_player.Name]:DoCleaning()
		Profiles._maids[_player.Name] = nil
	end

	local function saveProfile(_player, profile)
		if profile:GetAttribute("Loaded") then
			-- Tool reset if bugged
			for i, v in pairs(profile.tools:GetChildren()) do
				if v.Value == 10 then
					profile.tools.KickSlot.Value = 1
					profile.tools.SkillsSlot.Value = 2
					profile.tools.TackleSlot.Value = 3
					profile.tools.PassSlot.Value = 4
					profile.tools.GKSlot.Value = 5
				end
			end

			Profiles._profiles[_player].Data = Profiles._folderToDictionary(profile)
			Profiles._profiles[_player]:Release()

			profile:Destroy()
			print(string.format("[Profiles] Data successfully saved for %s (%s)", _player.Name, tostring(_player.UserId)))
		else
			Profiles._saveAttempts[_player] = 0
			while true do
				Profiles._saveAttempts[_player] += 1
				task.wait(7)
				if profile:GetAttribute("Loaded") then
					local profile = Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId))
					Profiles._profiles[_player].Data = Profiles._folderToDictionary(profile)
					Profiles._profiles[_player]:Release()

					profile:Destroy()
					Profiles._saveAttempts[_player] = nil
					print(string.format("[Profiles] Data successfully saved for %s (%s)", _player.Name, tostring(_player.UserId)))
					break
				end

				if Profiles._saveAttempts[_player] == 10 then
					Profiles._saveAttempts[_player] = nil
					if Profiles._profiles[_player] then
						Profiles._profiles[_player]:Release()
						print(string.format("[Profiles] Data restored to last savepoint for %s (%s)", _player.Name, tostring(_player.UserId)))
					end

					if Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)) then
						Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)):Destroy()
					end

					print(string.format("[Profiles] Data failed to save for %s (%s)", _player.Name, tostring(_player.UserId)))
					break
				end
			end
		end
	end

	if Profiles._profiles[_player] and Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)) then
		saveProfile(_player, Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)))
	else
		Profiles._saveAttempts[_player] = 0
		while true do
			Profiles._saveAttempts[_player] += 1
			task.wait(7)
			if Profiles._profiles[_player] and Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)) then
				saveProfile(_player, Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)))
				break
			end

			if Profiles._saveAttempts[_player] == 10 then
				Profiles._saveAttempts[_player] = nil
				if Profiles._profiles[_player] then
					Profiles._profiles[_player]:Release()
					print(string.format("[Profiles] Data restored to last savepoint for %s (%s)", _player.Name, tostring(_player.UserId)))
				end

				if Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)) then
					Profiles._replicatedStorage.network.Profiles:FindFirstChild(tostring(_player.UserId)):Destroy()
				end

				print(string.format("[Profiles] Data failed to save for %s (%s)", _player.Name, tostring(_player.UserId)))
				break
			end
		end
	end
end

