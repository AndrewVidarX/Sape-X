function Profiles._folderToDictionary(_folder)
	local _dictionary = {}

	for _index, _object in next, _folder:GetChildren() do
		if _object:IsA("Folder") then
			_dictionary[_object.Name] = {}

			for _index, _value in next, _object:GetChildren() do
				if _value:IsA("Folder") then
					_dictionary[_object.Name][_value.Name] = {}

					for _index, _data in next, _value:GetChildren() do
						if (_data:IsA("ValueBase") or _data.ClassName:match("Value")) then
							if _data:IsA("Color3Value") then
								_dictionary[_object.Name][_value.Name][_data.Name] = string.format("%s,%s,%s", tostring(_data.Value.R), tostring(_data.Value.G), tostring(_data.Value.B))
							else
								_dictionary[_object.Name][_value.Name][_data.Name] = tostring(_data.Value)
							end
						end
					end

				elseif (_value:IsA("ValueBase") or _value.ClassName:match("Value")) then
					if _value:IsA("Color3Value") then
						_dictionary[_object.Name][_value.Name] = string.format("%s,%s,%s", tostring(_value.Value.R), tostring(_value.Value.G), tostring(_value.Value.B))
					else
						_dictionary[_object.Name][_value.Name] = tostring(_value.Value)
					end
				end
			end
		elseif (_object:IsA("ValueBase") or _object.ClassName:match("Value")) then
			if _object:IsA("Color3Value") then
				_dictionary[_object.Name] = string.format("%s,%s,%s", tostring(_object.Value.R), tostring(_object.Value.G), tostring(_object.Value.B))
			else
				_dictionary[_object.Name] = tostring(_object.Value)
			end
		end
	end

	return _dictionary
end

