local function onLoadFailure(_player, _profile, _data)
	if _profile then
		_profile:Release()
	end

	if Profiles._profiles[_player] then
		Profiles._profiles[_player] = nil
	end

	if _data then
		_data:Destroy()
	end

	if _player and _player.Parent then
		_player:Kick("An unexpected error occured while loading") 
	end
end

function Profiles._load(_player, _data)
	if Profiles._profiles[_player] then
		local _dictionary = Profiles._profiles[_player]

		local function load(_folder, _array)
			if _folder then
				for _index, _table in next, _array do
					if type(_table) == "table" then
						load(_folder:FindFirstChild(_index), _table)
					else
						if _folder:FindFirstChild(_index) then
							local _value = _folder[_index]

							if _value.Name == _index and (_value:IsA("ValueBase") or _value.ClassName:match("Value")) then
								_value:SetAttribute("key", Profiles._references.Main.config.Key:GetAttribute("realKey"))
								if _value:IsA("Color3Value") then
									_value.Value = Color3.new(tonumber(_table:split(",")[1]), tonumber(_table:split(",")[2]), tonumber(_table:split(",")[3]))
								elseif _value:IsA("BoolValue") then
									if _table == "true" then
										_value.Value = true
									else
										_value.Value = false
									end
								else
									_value.Value = _table
								end
							end
						else
							local valueType = "StringValue"

							if _table == "true" or _table == "false" then
								valueType = "BoolValue"
							elseif string.find(_table, ",") then
								valueType = "Color3Value"
							end

							local _value = Instance.new(valueType)

							if _index == "Tshbalala" then
								_value.Name = "Tshabalala"
							else
								_value.Name = _index
							end

							_value:SetAttribute("key", Profiles._references.Main.config.Key:GetAttribute("realKey"))

							if _table == "true" then
								_value.Value = true
							elseif _table == "false" then
								_value.Value = false
							elseif string.find(_table, ",") then
								_value.Value = Color3.new(tonumber(_table:split(",")[1]), tonumber(_table:split(",")[2]), tonumber(_table:split(",")[3]))
							else
								_value.Value = _table
							end

							_value.Parent = _folder
						end
					end
				end
			end
		end
		load(_data, _dictionary.Data)

		for _, _reference in next, {"Accessories", "Boots", "Gloves", "Ball Holds", "Celebrations"} do
			local _container

			if _reference == "Celebrations" then
				_container = Profiles._references.Main.animations:WaitForChild(_reference, 100)
			elseif _reference == "Ball Holds" then
				_container = Profiles._references.Main.animations:WaitForChild("Ball", 100)
			else
				_container = Profiles._references.Main:WaitForChild(string.lower(_reference), 100)
			end

			for _index, _item in next, _container:GetChildren() do
				if _data.inventory:FindFirstChild(_reference) and game.PlaceId ~= 15690159367 and (table.find(Profiles._whitelist, _player.UserId) or (_item:FindFirstChild("Exclusive") and _item.Exclusive.Value == _player.UserId)) and _item and not _data.inventory[_reference]:FindFirstChild(_item.Name) then
					local Value = Instance.new("BoolValue")
					Value.Name = _item.Name
					Value.Value = true
					Value.Parent = _data.inventory[_reference]
					Value:SetAttribute("key", Profiles._references.Main.config.Key:GetAttribute("realKey"))
				end
			end	
		end

		if table.find(Profiles._testers, _player.UserId) and not _data.inventory.Boots:FindFirstChild("RF Tester") then
			local Value = Instance.new("BoolValue")
			Value.Name = "RF Tester"
			Value.Value = true 
			Value.Parent = _data.inventory.Boots
			Value:SetAttribute("key", Profiles._references.Main.config.Key:GetAttribute("realKey"))
		end

		if game.PlaceId == 15690159367 then
			_data.stats.Cash.Value = 10000
		end

		_data:SetAttribute("Loaded", true)
		print(string.format("[Profiles] Data successfully loaded for %s (%s)", _player.Name, tostring(_player.UserId)))
	else
		_data:SetAttribute("Loaded", false)
		print(string.format("[Profiles] Data failed to load for %s", _player.Name))
		onLoadFailure(_player, Profiles._profiles[_player], _data)
	end
end

function Profiles._playerAdded(_player : Player)
	--local initTime = tick()
	local _data = Profiles._sample:Clone()
	local _profile = Profiles._storage:LoadProfileAsync("user_" .. _player.UserId)
	--local finishTime = tick() - initTime
	--print("Profile loaded in", finishTime, " for", _player.Name, tostring(_player.UserId))
	local _maid = Profiles._maid.new()

	Profiles._maids[_player.Name] = _maid
	_data.Parent = Profiles._replicatedStorage.network.Profiles
	_data.Name = tostring(_player.UserId)

	for _,v in next, _data:GetDescendants() do
		if (v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("BoolValue") or v:IsA("Color3Value")) and v.Name ~= "Min" and v.Name ~= "Max" and v.Name ~= "Load" then
			local Default = Instance.new(v.ClassName, v)
			Default.Name = "DefaultValue"
			Default.Value = v.Value
		end
	end

	if _profile then
		_profile:AddUserId(_player.UserId)
		_profile:Reconcile()

		_profile:ListenToRelease(function()
			Profiles._profiles[_player] = nil
			if _player and _player.Parent then
				_player:Kick() 
			end
		end)

		if _player:IsDescendantOf(Profiles._players) == true then
			Profiles._profiles[_player] = _profile
			Profiles._load(_player, _data)
		else
			onLoadFailure(_player, _profile, _data)
		end
	else
		_player:Kick("An unexpected error occured while loading") 
	end

	return "Data finished loading"
end

