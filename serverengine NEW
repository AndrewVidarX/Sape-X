	["saveSetting"] = function(player, object, value)

		if typeof(object) ~= "Instance" or not object:IsA("ValueBase") then
			return
		end

		local profile = references.Network.Profiles:FindFirstChild(tostring(player.UserId))

		if not profile or not object:IsDescendantOf(profile) then
			return
		end

		if typeof(value) ~= typeof(object.Value) then
			return
		end

		if (object.Name == "Number" and value >= 100)
			or object:FindFirstAncestor("level")
			or (object:FindFirstAncestor("stats") and object.Name ~= "Number") then
			return
		end

		local parent = object.Parent and object.Parent.Parent
		if not parent then
			return
		end

		if string.find(object.Name, "Accessory")
			or string.find(object.Name, "Ball Hold") then

			if value ~= "None" and value ~= "RF Premium" then
				local folderName = string.find(object.Name, "Accessory") and "Accessories" or "Ball Holds"
				local folder = parent:FindFirstChild(folderName)

				if not folder or not folder:FindFirstChild(value) then
					return
				end
			end
		end

		object.Value = value

	end,


