local function ban(player, reason)
	local config: BanConfigType = {
		UserIds = {player.UserId},
		Duration = -1,
		DisplayReason = reason,
		PrivateReason = reason,
		ExcludeAltAccounts = false,
		ApplyToUniverse = true
	}

	local success, errorMessage = pcall(function()
		return _G._services.Players:BanAsync(config)
	end)

	print(success, errorMessage)
end

local function isTeammate(player, target)
	if services.Players:GetPlayerFromCharacter(target) then
		local plr = services.Players:GetPlayerFromCharacter(target)

		if (player.Team.Name == "Home" and plr.Team.Name == "Home") or (player.Team.Name == "Home" and plr.Team.Name == "-Home GK") or (player.Team.Name == "-Home GK" and plr.Team.Name == "Home")  or (player.Team.Name == "Home" and plr.Team.Name == "Home GK") or (player.Team.Name == "Home GK" and plr.Team.Name == "Home") or (player.Team.Name == "Away" and plr.Team.Name == "Away") or (player.Team.Name == "Away" and plr.Team.Name == "-Away GK") or (player.Team.Name == "-Away GK" and plr.Team.Name == "Away") or (player.Team.Name == "Away" and plr.Team.Name == "Away GK") or (player.Team.Name == "Away GK" and plr.Team.Name == "Away")  then
			return true
		else
			return false
		end
	else
		return false
	end
end

local function isOnPitch(part)
	return part.Position.X <= workspace.pitch.bounds.x.max.Position.X and part.Position.X >= workspace.pitch.bounds.x.min.Position.X and part.Position.Z <= workspace.pitch.bounds.z.max.Position.Z and part.Position.Z >= workspace.pitch.bounds.z.min.Position.Z
end

local function isSolidObject(part)
	local solidObjects = {"grass", "outer", "wall", "frame", "collide", "support", "support main", "support top", "ropes"}
	return table.find(solidObjects, string.lower(part.Name))
end

