	["purchase"] = function(player, item, category)
		local profile = references.Network.Profiles[tostring(player.UserId)]
		local price = 999999999

		if item:FindFirstChild("Price") then
			price = item.Price.Value
		end

		if category == "Ball" then
			category = "Ball Holds"
		end

		if profile.stats.Cash.Value - price < 0 then
			return "error", "Insufficient funds!"
		elseif profile.inventory[category]:FindFirstChild(item.Name) then
			return "error", "Duplicate item detected!"
		else
			profile.stats.Cash.Value -= price

			local boolValue = Instance.new("BoolValue")
			boolValue.Name = item.Name
			boolValue.Value = true
			boolValue:SetAttribute("key", references.Main.config.Key:GetAttribute("realKey"))
			boolValue.Parent = profile.inventory[category]

			return "success", "Purchase successful!"
		end
	end,

	["redeem"] = function(player, code)
		local profile = references.Network.Profiles[tostring(player.UserId)]

		if profile.codes:FindFirstChild(code) then
			return "error", "Code has already been redeemed!"
		elseif not services.ServerStorage.codes:FindFirstChild(code) then
			return "error", "Code is invalid or expired!"
		elseif services.ServerStorage.codes:FindFirstChild(code) and not profile.codes:FindFirstChild(code) then
			local reference = services.ServerStorage.codes[code]

			if string.find(reference.Value, "Cash") then
				local cash = reference.Value:split("Cash")

				if cash and cash[1] then
					cash = cash[1]:gsub(" ", "")
					profile.stats.Cash.Value += tonumber(cash)
				end

				local codeValue = Instance.new("BoolValue")
				codeValue.Name = code
				codeValue.Value = true
				codeValue.Parent = profile.codes

				return "success", string.format("Successfully redeemed %s RF points!", formatNumber.FormatLong(tonumber(cash)))
			end

			local item = references.Main:FindFirstChild(string.lower(reference.category.Value)) and references.Main:FindFirstChild(string.lower(reference.category.Value))[reference.Value] or references.Main.animations:FindFirstChild(reference.category.Value) and references.Main.animations:FindFirstChild(reference.category.Value)[reference.Value]
			local category = reference.category.Value

			local codeValue = Instance.new("BoolValue")
			codeValue.Name = code
			codeValue.Value = true
			codeValue.Parent = profile.codes

			if category == "Ball" then
				category = "Ball Holds"
			end

			if profile.inventory[category]:FindFirstChild(reference.Value) and item:FindFirstChild("Price") then
				profile.stats.Cash.Value += item.Price.Value
				return "success", string.format("Duplicate item detected, %s RF points rewarded instead.", formatNumber.FormatLong(item.Price.Value))
			elseif profile.inventory[category]:FindFirstChild(reference.Value) and not item:FindFirstChild("Price") then
				return "error", "Code has already been redeemed!"
			else
				local boolValue = Instance.new("BoolValue")
				boolValue.Name = item.Name
				boolValue.Value = true
				boolValue:SetAttribute("key", references.Main.config.Key:GetAttribute("realKey"))
				boolValue.Parent = profile.inventory[category]

				return "success", string.format("Successfully redeemed %s!", reference.Value)
			end
		end
	end,

