local function getSubscriptionStatus(player, subscriptionId)
	local subscriptionStatus = subscriptionService:getSubscriptionStatus(player, subscriptionId)
	if subscriptionStatus.IsSubscribed then
		local profile = references.Profiles:WaitForChild(tostring(player.UserId), 100)
		player:SetAttribute("hasRFPremium", true)
		if profile then
			profile.stats.LastRenewal.Value = tostring(tick())
			profile.stats.Cash.Value += 1000
		end
	end
end

local function onPromptSubscriptionPurchaseFinished(player: Player, subscriptionId: string, didTryPurchasing: boolean)
	getSubscriptionStatus(player, subscriptionId)
	if didTryPurchasing then
		task.delay(10, function()
			getSubscriptionStatus(player, subscriptionId)
		end)
	end
end

_G._services.MarketplaceService.PromptSubscriptionPurchaseFinished:Connect(onPromptSubscriptionPurchaseFinished)

--[[  Developer Products  ]]------------------------------------------------------------------

local purchaseHistoryStore = services.DataStoreService:GetDataStore("PurchaseHistory")
local monetization = engine:load("Monetization", "utils")
local developerProducts = {}

for productName, productData in next, monetization.developerProducts do
	if productName and productData and productData["onPurchaseGranted"] then
		developerProducts[tostring(productData.productId)] = productData.onPurchaseGranted
	end
end

local function processReceipt(receiptInfo)
	local playerProductKey = receiptInfo.PlayerId .. "_" .. receiptInfo.PurchaseId
	local purchased = false
	local success, errorMessage = pcall(function()
		purchased = purchaseHistoryStore:GetAsync(playerProductKey)
	end)

	if success and purchased then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif not success then
		error("Data store error:" .. errorMessage)
	end

	local player = services.Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local handler = developerProducts[tostring(receiptInfo.ProductId)]
	local success, result = pcall(handler, receiptInfo, player)

	if not success or not result then
		warn("Error occurred while processing a product purchase")
		print("\nProductId:", receiptInfo.ProductId)
		print("\nPlayer:", player)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local success, errorMessage = pcall(function()
		purchaseHistoryStore:SetAsync(playerProductKey, true)
	end)

	if not success then
		error("Cannot save purchase data: " .. errorMessage)
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

services.MarketPlaceService.ProcessReceipt = processReceipt

