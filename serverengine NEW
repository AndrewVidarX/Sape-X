	end

	if references.Main.config.Weather.Value == "Rain" and references.Main.config.Intensity.Value ~= "Light" and references.Main.config.Thunder.Value then
		local position = Vector3.new(math.random(workspace.pitch.bounds.x.min.Position.X, workspace.pitch.bounds.x.max.Position.X), 0.42, math.random(workspace.pitch.bounds.z.min.Position.Z, workspace.pitch.bounds.z.max.Position.Z))

		for _,v in next, services.Players:GetPlayers() do
			if v and v.Character and math.random(1, 12000) == 1 then
				position = Vector3.new(v.Character.PrimaryPart.Position.X, 0.42, v.Character.PrimaryPart.Position.Z)

				references.RemoteEvent:FireClient(v, "ragdoll")
				task.delay(math.random(5, 20), function()
					references.RemoteEvent:FireClient(v, "unragdoll")
				end)
			end
		end

		references.RemoteEvent:FireAllClients("lightning", position)
	end
end
