					elseif args.ball:GetAttribute("possessor") ~= 0 and services.Players[services.Players:GetNameFromUserIdAsync(args.ball:GetAttribute("possessor"))]:FindFirstChild("Ping") and services.Players[services.Players:GetNameFromUserIdAsync(args.ball:GetAttribute("possessor"))].Ping.Value >= ping.Value then
						local newPing = services.Players[services.Players:GetNameFromUserIdAsync(args.ball:GetAttribute("possessor"))]:WaitForChild("Ping", 100)
						lifeTime = (newPing.Value / 1000) / 0.45
					end

					local transition = Instance.new("IntValue", args.ball.properties)
					transition.Name = "transition"
					transition.Value = player.UserId
					services.Debris:AddItem(transition, lifeTime)
				end

				if args.forceNetworkOwner then
					local decline = Instance.new("BoolValue", args.ball.properties)
					decline.Name = "decline"
					decline.Value = true

					services.Debris:AddItem(decline, firstTouchCooldown)
				end

				if previousOwner ~= 0 then
					local firstTouchValue = Instance.new("IntValue")
					firstTouchValue.Name = "firstTouch"
					firstTouchValue.Value = previousOwner
					firstTouchValue.Parent = args.ball.properties
					services.Debris:AddItem(firstTouchValue, firstTouchCooldown * 1.5)
				end

				for _, plr in next, services.Players:GetPlayers() do
					if plr and plr.UserId == previousOwner and args.ball:GetAttribute("lastTouchTime") and references.Main.config.AutoSystem.Value then
						if string.find(plr.Team.Name, "Home") then
							references.Main.config.Stats.Home.Timer.Value += math.floor(tick() - args.ball:GetAttribute("lastTouchTime"))
						elseif string.find(plr.Team.Name, "Away") then
							references.Main.config.Stats.Away.Timer.Value += math.floor(tick() - args.ball:GetAttribute("lastTouchTime"))
						end

						local total = references.Main.config.Stats.Home.Timer.Value + references.Main.config.Stats.Away.Timer.Value
						local homePercentage = math.floor((references.Main.config.Stats.Home.Timer.Value / total) * 100)
						local awayPercentage = 100 - homePercentage

						references.Main.config.Stats.Home.Possession.Value = homePercentage
						references.Main.config.Stats.Away.Possession.Value = awayPercentage
					end
				end

				args.ball.CollisionGroup = "17_clientBall"
				references.RemoteEvent:FireAllClients("collisionGroup", args.ball, "17_clientBall", player)

				if args.penalty then
					args.ball:SetAttribute("penalty", true)
				else
					args.ball:SetAttribute("penalty", nil)
				end
				if args.freeKick then
					args.ball:SetAttribute("freeKick", true)
				else
					args.ball:SetAttribute("freeKick", nil)
				end

				if args.tackle and string.find(player.Team.Name, "Home") and references.Main.config.AutoSystem.Value then
					references.Main.config.Stats.Home.Interceptions.Value += 1
				elseif args.tackle and string.find(player.Team.Name, "Away") and references.Main.config.AutoSystem.Value then
					references.Main.config.Stats.Away.Interceptions.Value += 1
				end

				if args.ball:GetAttribute("lastPass") then
					for _, plr in next, services.Players:GetPlayers() do
						if plr and plr.UserId == args.ball:GetAttribute("lastPass") then
							if plr ~= player and ((string.find(player.Team.Name, "Home") and string.find(plr.Team.Name, "Home")) or (string.find(player.Team.Name, "Away") and string.find(plr.Team.Name, "Away"))) then
								local lastPassProfile = references.Profiles:WaitForChild(tostring(args.ball:GetAttribute("lastPass")), 100)

								if lastPassProfile and game.PrivateServerOwnerId == 0 and references.Main.config.AutoSystem.Value and _G._services.Players.NumPlayers >= math.floor(_G._maxPlayers / 2) then
									local doubleXP = monetization.userOwnsPass(player, monetization.gamePasses["2x XP"].gamePassId)

									if doubleXP then
										previousOwnerProfile.level.XP.Value += 10
									else
										previousOwnerProfile.level.XP.Value += 5
									end

									lastPassProfile.stats["Accurate Passes"].Value += 1
								end

								if string.find(player.Team.Name, "Home") and references.Main.config.AutoSystem.Value and _G._services.Players.NumPlayers >= math.floor(_G._maxPlayers / 2) then
									references.Main.config.Stats.Home["Accurate Passes"].Value += 1
								elseif string.find(player.Team.Name, "Away") and references.Main.config.AutoSystem.Value and _G._services.Players.NumPlayers >= math.floor(_G._maxPlayers / 2) then
									references.Main.config.Stats.Away["Accurate Passes"].Value += 1
								end

								args.ball:SetAttribute("lastPassSession", nil)
							elseif args.ball:GetAttribute("lastPassSession") then
								args.ball:SetAttribute("lastPass", nil)
								args.ball:SetAttribute("lastPassSession", nil)
							end
						end
					end
				end

				if args.updateStats == "Passes" then
					local lastPassSession = services.HttpService:GenerateGUID(false)

					args.ball:SetAttribute("lastPass", player.UserId)
					args.ball:SetAttribute("lastPassSession", lastPassSession)

					task.delay(20, function()
						if args.ball:GetAttribute("lastPass") and args.ball:GetAttribute("lastPass") == player.UserId and args.ball:GetAttribute("lastPassSession") and args.ball:GetAttribute("lastPassSession") == lastPassSession then
							args.ball:SetAttribute("lastPass", nil)
							args.ball:SetAttribute("lastPassSession", nil)
						end
					end)
				end

				args.ball:SetNetworkOwner(player)
				args.ball:SetAttribute("network", 0)
				args.ball:SetAttribute("lastTouch", player.UserId)
				args.ball:SetAttribute("lastTouchTime", tick())
				args.ball:SetAttribute("possessor", player.UserId)
				args.ball:SetAttribute("networkOwner", player.UserId)
				args.ball.network.owner.Value = player

				if _G._services.ReplicatedStorage:FindFirstChild("physics") and _G._services.ReplicatedStorage.physics:FindFirstChild("network") then
					_G._services.ReplicatedStorage.physics.network:Fire(args.ball, networkOwner, player)
				end

				if connection then
					connection:Disconnect()
				end

				if bodyPosition and alignOrientation then
					bodyPosition:Destroy()
					alignOrientation:Destroy()
				end

				return "react"
			end
		end
	end,

	["catch"] = function(player, args)
		local ping = player:WaitForChild("Ping", 100)

		if args.ball:GetAttribute("catch") then
			return false
		end
		
	--[[if player.Character:FindFirstChild("HumanoidRootPart") and (args.ball.Position - player.Character.HumanoidRootPart.Position).Magnitude >= 150 then
			ban(player, "Unauthorised Catch Detected")
			return false
		end
		if args.cframe and (args.ball.Position - args.cframe.Position).Magnitude >= 180 then
			ban(player, "Unauthorised Catch Detected")
			return false
		end]]
		if player.Character:FindFirstChild("HumanoidRootPart") and (args.ball.Position - player.Character.HumanoidRootPart.Position).Magnitude >= 50 then
			return false
		end
		if args.cframe and (args.ball.Position - args.cframe.Position).Magnitude >= 60 then
			return false
		end

		if player.Character and player.Character:FindFirstChild("Ball") then
			local centre = args.ball:WaitForChild("centre", 100)
			local profile = references.Profiles:WaitForChild(tostring(player.UserId), 100)
			local previousOwnerProfile

			if args.ball:GetAttribute("possessor") ~= 0 then
				previousOwnerProfile = references.Profiles:WaitForChild(tostring(args.ball:GetAttribute("possessor")), 100)
			end

			if not args.throwIn then
				if _G._references.Main.config.Override:FindFirstChild("Goal") then
					_G._references.Main.config.Override.Goal:SetAttribute("save", true)
				end
				if _G._references.Main.config.Delay:FindFirstChild("NoReact") then
					_G._references.Main.config.Delay.NoReact:Destroy()
				end
			end
			if string.find(player.Team.Name, "GK") and _G._references.Main.config.Override:FindFirstChild("Foul") and _G._references.Main.config.Override:FindFirstChild("Offender") and _G._references.Main.config.Override.Offender.Value == player then
				_G._references.Main.config.Override.Foul:Destroy()
				_G._references.Main.config.Override.Offender:Destroy()
			end

			if references.Main.config.AutoSystem.Value then
				local function reset()
					gkSpaceMaid:DoCleaning()

					if args.ball and args.ball.Parent then
						args.ball:SetAttribute("freeKick", nil)
						args.ball:SetAttribute("penalty", nil)
						args.ball:SetAttribute("catch", nil)
						args.ball:SetAttribute("lastTouch", 0)
						args.ball:SetAttribute("possessor", 0)
						args.ball:SetAttribute("networkOwner", 0)
						args.ball:SetAttribute("network", 0)
						args.ball.network.owner.Value = nil
						args.ball:SetNetworkOwner(nil)
						args.ball.CanCollide = true

						if _G._references.Main.config.Override:FindFirstChild("Goal") then
							_G._references.Main.config.Override.Goal:Destroy()
						end

						if _G._references.Main.config.Delay:FindFirstChild("NoReact") then
							_G._references.Main.config.Delay.NoReact:Destroy()
						end

						if args.resetVelocity then
							args.ball.AssemblyLinearVelocity = Vector3.new()
							args.ball.AssemblyAngularVelocity = Vector3.new()
						end

						if args.ball.design:FindFirstChildWhichIsA("BasePart") then
							args.ball.design:FindFirstChildWhichIsA("BasePart").Transparency = 0
						end
						if player and player.Parent and player.Character and player.Character:FindFirstChild("Ball") and player.Character.Ball.design:FindFirstChildWhichIsA("BasePart") then
							player.Character.Ball.design:FindFirstChildWhichIsA("BasePart").Transparency = 1
						end

						references.RemoteEvent:FireAllClients("ballModel", {
							exclude = player,
							ball = args.ball,
							transparency = 0
						})

						for _,v in next, args.ball:GetChildren() do
							if v:IsA("AlignPosition") then
								v:Destroy()
							end
						end
					end
				end

				if not args.throwIn then
					if string.find(player.Team.Name, "GK") then
						local reference = "home"

						if string.find(player.Team.Name, "Away") then
							reference = "away"
						end

						local side = workspace.game.regions[reference]
						if not (player.Character:FindFirstChild("HumanoidRootPart").Position.X >= side.Position.X - (side.Size.X / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.X <= side.Position.X + (side.Size.X / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Y >= side.Position.Y - (side.Size.Y / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Y <= side.Position.Y + (side.Size.Y / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Z >= side.Position.Z - (side.Size.Z / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Z <= side.Position.Z + (side.Size.Z / 2)) then
							reset()
							return
						end
					else
						reset()
						return
					end
				else
					local part = workspace.game.regions:WaitForChild("field")
					if (player.Character:FindFirstChild("HumanoidRootPart").Position.X >= part.Position.X - (part.Size.X / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.X <= part.Position.X + (part.Size.X / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Y >= part.Position.Y - (part.Size.Y / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Y <= part.Position.Y + (part.Size.Y / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Z >= part.Position.Z - (part.Size.Z / 2) and player.Character:FindFirstChild("HumanoidRootPart").Position.Z <= part.Position.Z + (part.Size.Z / 2)) then
						reset()
						return
					end
				end

				gkSpaceMaid["_CharacterAdded"] = player.CharacterAdded:Connect(function()
					reset()
				end)

				gkSpaceMaid["_BallRemoving"] = workspace.game.balls.server.ChildRemoved:Connect(function(ball)
					if ball == args.ball then
						reset()
					end
				end)

				gkSpaceMaid["_OnEvent"] = references.BindableEvent.Event:Connect(function(signal)
					if signal and signal == "clearSpace" then
						reset()
					end
				end)

				gkSpaceMaid["_PlayerRemoving"] = services.Players.PlayerRemoving:Connect(function(plr)
					if plr == player then
						reset()
					end
				end)
			end

			if string.find(player.Team.Name, "GK") and references.Main.config.AutoSystem.Value and not args.throwIn and not references.Main.config.Penalties.Enabled.Value then
				local reference = "home"

				if string.find(player.Team.Name, "Away") then
					reference = "away"
				end

				local function onTouched(hit)
					if hit and hit.Parent and hit.Parent:FindFirstChild("Humanoid") and not hit:FindFirstAncestor("referee") and not hit:FindFirstAncestor("manager") and hit.Parent ~= player.Character then
						if services.Players:GetPlayerFromCharacter(hit.Parent) then
							local playerFromCharacter = services.Players:GetPlayerFromCharacter(hit.Parent)
							local teleport = Instance.new("BoolValue", playerFromCharacter)
							teleport.Name = "Teleport"
							teleport.Value = true
							services.Debris:AddItem(teleport, 3)
						end

						hit.Parent:SetPrimaryPartCFrame(workspace.game.space[reference].CFrame)
					end
				end

				gkSpaceMaid[reference .. "_Touched"] = workspace.game.regions[reference].Touched:Connect(onTouched)
				gkSpaceMaid[reference .. "_TouchEnded"] = workspace.game.regions[reference].TouchEnded:Connect(onTouched)

				task.delay(6, function()
					if gkSpaceMaid[reference .. "_Touched"] then
						gkSpaceMaid:DoCleaning()
					end
				end)
			end

			args.ball.CollisionGroup = "17_clientBall"
			references.RemoteEvent:FireAllClients("collisionGroup", args.ball, "17_clientBall", player)

			if references.Main.config.AutoSystem.Value and not args.throwIn then
				if previousOwnerProfile and game.PrivateServerOwnerId == 0 and _G._services.Players.NumPlayers >= math.floor(_G._maxPlayers / 2) then
					local doubleXP = monetization.userOwnsPass(player, monetization.gamePasses["2x XP"].gamePassId)

					if doubleXP then
						previousOwnerProfile.level.XP.Value += 10
					else
						previousOwnerProfile.level.XP.Value += 5
					end

					previousOwnerProfile.stats["Accurate Shots"].Value += 1
				end
				if string.find(player.Team.Name, "Home") then
					references.Main.config.Stats.Home.Saves.Value += 1
					references.Main.config.Stats.Away["Accurate Shots"].Value += 1
				elseif string.find(player.Team.Name, "Away") then
					references.Main.config.Stats.Away.Saves.Value += 1
					references.Main.config.Stats.Home["Accurate Shots"].Value += 1
				end
				if game.PrivateServerOwnerId == 0 and _G._services.Players.NumPlayers >= math.floor(_G._maxPlayers / 2) then
					profile.stats.Saves.Value += 1

					if _G._references.Main.objectives:FindFirstChild(tostring(player.UserId)) then
						local playerObjectives = _G._references.Main.objectives:WaitForChild(tostring(player.UserId), 100)
						local doubleXP = monetization.userOwnsPass(player, monetization.gamePasses["2x XP"].gamePassId)
						local doublePoints = monetization.userOwnsPass(player, monetization.gamePasses["2x Points"].gamePassId)

						if playerObjectives and profile then
							for _,v in next, playerObjectives:GetChildren() do
								if v and objectives._objectives[v.Name] then
									local reference = v.Name
									local objective = objectives._objectives[reference]

									local function objectiveCompleted()
										if doubleXP then
											profile.level.XP.Value += objective._rewards.xp * 2
											_G._references.RemoteEvent:FireClient(player, "notification", string.format("%s XP REWARDED FOR COMPLETING A DAILY OBJECTIVE", tostring(objective._rewards.xp * 2)), "success")
										else
											profile.level.XP.Value += objective._rewards.xp
											_G._references.RemoteEvent:FireClient(player, "notification", string.format("%s XP REWARDED FOR COMPLETING A DAILY OBJECTIVE", tostring(objective._rewards.xp)), "success")
										end
										if doublePoints then
											profile.stats.Cash.Value += objective._rewards.points * 2
											_G._references.RemoteEvent:FireClient(player, "notification", string.format("%s RF POINTS REWARDED FOR COMPLETING A DAILY OBJECTIVE", tostring(objective._rewards.points * 2)), "success")
										else
											profile.stats.Cash.Value += objective._rewards.points
											_G._references.RemoteEvent:FireClient(player, "notification", string.format("%s RF POINTS REWARDED FOR COMPLETING A DAILY OBJECTIVE", tostring(objective._rewards.points)), "success")
										end
									end

									if string.find(string.lower(reference), "make") and string.find(string.lower(reference), "saves") then
										if #v:GetChildren() < objective._repeat then
											local boolValue = Instance.new("BoolValue")
											boolValue.Name = tostring(#v:GetChildren() + 1)
											boolValue.Parent = v

											if tostring(boolValue.Name) == tostring(objective._repeat) then
												v.Value = true
												objectiveCompleted()
											end
										end
									end
								end
							end
						end
					end
				end
			end

			args.ball:SetAttribute("freeKick", nil)
			args.ball:SetAttribute("penalty", nil)
			args.ball:SetAttribute("catch", player.UserId)
			args.ball:SetAttribute("lastTouch", player.UserId)
			args.ball:SetAttribute("possessor", player.UserId)
			args.ball:SetAttribute("networkOwner", player.UserId)
			args.ball:SetAttribute("network", 0)
			args.ball.network.owner.Value = player

			args.ball.CanCollide = false

			local alignPosition = Instance.new("AlignPosition", args.ball)
			alignPosition.Mode = Enum.PositionAlignmentMode.TwoAttachment
			alignPosition.Attachment0 = centre
			alignPosition.Attachment1 = player.Character.Ball.BallWeldRigAttachment
			alignPosition.MaxForce = 1e5
			alignPosition.Responsiveness = 30
			alignPosition.Enabled = true

			references.RemoteEvent:FireAllClients("ballModel", {
				exclude = player,
				ball = args.ball,
				transparency = 1
			})

			if args.ball.design:FindFirstChildWhichIsA("BasePart") then
				args.ball.design:FindFirstChildWhichIsA("BasePart").Transparency = 1
			end
			if player.Character.Ball.design:FindFirstChildWhichIsA("BasePart") then
				player.Character.Ball.design:FindFirstChildWhichIsA("BasePart").Transparency = 0
			end

			glt:create(args.cframe)
			args.ball:SetNetworkOwner(player)

			return true
		end
	end,

