			return services.TextService:FilterStringAsync(text, player.UserId)
		end)

		if filterSuccess then
			local broadcastSuccess, filteredString = pcall(function()
				return textObject:GetNonChatStringForBroadcastAsync()
			end)

			if broadcastSuccess then
				return filteredString
			else
				warn(string.format("An unexpected error occured while broadcasting string (%s)", textObject))
