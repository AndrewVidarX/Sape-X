local function lerp(a, b, t)
	return a + (b - a) * t
end


local function isTeammate(player, target)
	if (player.Team and target.Team) and ((player.Team.Name == "Home" and target.Team.Name == "Home") or (player.Team.Name == "Home" and target.Team.Name == "-Home GK") or (player.Team.Name == "-Home GK" and target.Team.Name == "Home")  or (player.Team.Name == "Home" and target.Team.Name == "Home GK") or (player.Team.Name == "Home GK" and target.Team.Name == "Home") or (player.Team.Name == "Away" and target.Team.Name == "Away") or (player.Team.Name == "Away" and target.Team.Name == "-Away GK") or (player.Team.Name == "-Away GK" and target.Team.Name == "Away") or (player.Team.Name == "Away" and target.Team.Name == "Away GK") or (player.Team.Name == "Away GK" and target.Team.Name == "Away")) then
		return true
	else
		return false
	end
end

local function getClientBall(ball)
	if ball and ball:FindFirstChild("properties") and ball.properties:FindFirstChild("spawner") then
		local spawnerFolder, clientFolder

		for _, folder in next, ball.Parent.Parent:GetChildren() do
			if services.CollectionService:HasTag(folder, "SpawnersFolder") then
				spawnerFolder = folder
			elseif services.CollectionService:HasTag(folder, "ClientBallsFolder") then
				clientFolder = folder
			end
		end

		if spawnerFolder and clientFolder then
			for _, spawner in next, spawnerFolder:GetChildren() do
				if spawner and ball.properties.spawner.Value == spawner then
					for _, clientBall in next, clientFolder:GetChildren() do
						if clientBall and clientBall:FindFirstChild("properties") and clientBall.properties:FindFirstChild("spawner") and clientBall.properties.spawner.Value == spawner then
							return clientBall
						end
					end
				end
			end
		end
	end
end

