		["updateCounter"] = function()
			local useBadgeCount = false
			
			if useBadgeCount then
				local silvers = 0
				local shines = 0

				for index = 1, 3 do
					local badge = badgeService._badges["Quest " .. tostring(index)]
					if badgeService:hasBadge(localPlayer, badge) then
						silvers += 1
					end
				end

				for index = 1, 5 do
					local badge = badgeService._badges["Item " .. tostring(index)]
					if badgeService:hasBadge(localPlayer, badge) then
						shines += 1
					end
				end

				playerGui.main.quests.progress.progress:TweenSize(UDim2.new(1, 0, silvers / 3, 0), Enum.EasingDirection.InOut, Enum.EasingStyle.Sine, 0.35, true)
				playerGui.main.counter.silvers.count.Text = tostring(silvers)
				playerGui.main.counter.shines.count.Text = tostring(shines)
			else
				local value = references.Main.event:WaitForChild(localPlayer.Name, 100)
				
				if value:GetAttribute("quest1") then
					services.TweenService:Create(playerGui.main.event.quests.icons["1"], TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundColor3 = Color3.fromRGB(85, 255, 127)}):Play()
