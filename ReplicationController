				if connection then
					connection:Disconnect()
				end

				connection = _G._services.RunService.RenderStepped:Connect(function(delta)
					if not folder.cutsceneSettings.LockOnTarget.Value then
						connection:Disconnect()
						
						if not folder.special:FindFirstChild(args.Name) then
