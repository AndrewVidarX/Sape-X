					services.TweenService:Create(workspace.CurrentCamera, TweenInfo.new(tonumber(args.duration.Value + 0.35), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {CFrame = folder.special[args.Name].finish.CFrame}):Play()
				end
				
