								connection = _G._services.RunService.RenderStepped:Connect(function(delta)
									if cameraOverride and cameraOverride.Parent then
										workspace.CurrentCamera.FieldOfView  = tonumber(folder.cutsceneSettings.CameraFieldOfView.Value)
										workspace.CurrentCamera.CFrame = CFrame.lookAt(angle2.CFrame.Position, target.CFrame.Position)
