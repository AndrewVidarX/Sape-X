		["displayAward"] = function(reference, part)
			local connection
			local duration = 0.5
			local transition = 0.5
			local start = tick()
			local total = duration + 4 + transition
			
			if reference == "TGE_Shines" then
				references.Main.sounds.UI.Shines:Play()
			elseif reference == "TGE_Silver" then
				references.Main.sounds.UI.Silver:Play()
			end
			
			playerGui.main.item.Visible = true
			playerGui.main.screen.Visible = true
			
			if part then
				part:Destroy()
			end
			
			services.TweenService:Create(playerGui.main.screen, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.3}):Play()
			
			local award = references.Main.storage[reference]:Clone()
			award.Parent = playerGui.main.item
			
			local clone = references.Main.storage[reference]:Clone()
			clone.Parent = workspace.game.debug
			clone.CFrame = award.CFrame * CFrame.new(0, -50, 0)

			local origin = clone.CFrame
			
			local viewportCamera = Instance.new("Camera", playerGui.main.item)
			viewportCamera.CFrame = award.CFrame * CFrame.new(0, 10, -7) * CFrame.fromEulerAnglesXYZ(0, math.rad(180), 0)
			playerGui.main.item.CurrentCamera = viewportCamera
			
			connection = services.RunService.RenderStepped:Connect(function()
				local spinStep = math.rad(350)
				local spinLerp = math.clamp((tick() - start) / total, 0, 1)
				award.CFrame = ((clone.CFrame * CFrame.new(0, 50, 0)) * CFrame.Angles(0, 0, math.rad(15))) * CFrame.Angles(0, spinStep * spinLerp, 0)
			end)
			
			services.TweenService:Create(clone, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {CFrame = origin * CFrame.new(0, 10, 0)}):Play()
			task.wait(0.2)
			
			services.TweenService:Create(playerGui.main.aura, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {GroupTransparency = 0}):Play()
			services.TweenService:Create(playerGui.main.aura.sunburst, TweenInfo.new((duration - 0.2) + 2 + transition, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Rotation = 450}):Play()
			
			task.wait((duration - 0.2) + 4)

			services.TweenService:Create(clone, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {CFrame = origin}):Play()
			services.TweenService:Create(playerGui.main.screen, TweenInfo.new(transition, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 1}):Play()
			services.TweenService:Create(playerGui.main.aura, TweenInfo.new(transition, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {GroupTransparency = 1}):Play()
			
			task.wait(transition)
			
			playerGui.main.aura.sunburst.Rotation = 0
			playerGui.main.item.Visible = false
			playerGui.main.screen.Visible = false
			
			connection:Disconnect()
			clone:Destroy()
			award:Destroy()
			viewportCamera:Destroy()
		end,
		
