		["registerTeleporter"] = function(exclude, model, preset)
			if localPlayer == exclude then
				return
			end
			
			if preset == "kickoff" then
				local function onTouch(hit)
					if hit and hit.Parent and hit.Parent:FindFirstChildWhichIsA("Humanoid") and hit.Parent == localPlayer.Character then
						network:send("pitchTeleporter")
					end
				end
				
				local function onTouchRegion(hit, part)
					if hit and hit.Parent and hit.Parent:FindFirstChildWhichIsA("Humanoid") and hit.Parent == localPlayer.Character then
						if localPlayer.Team and string.find(localPlayer.Team.Name, "Home") and part.Name == "Away" then
							network:send("pitchTeleporter")
						elseif localPlayer.Team and string.find(localPlayer.Team.Name, "Away") and part.Name == "Home" then
							network:send("pitchTeleporter")
						end
					end
				end

				for _, part in next, model.Area:GetChildren() do
					if part and part:IsA("BasePart") then
						local key = _G._services.HttpService:GenerateGUID(false)
						teleportMaid[key .. "_onTouched"] = part.Touched:Connect(onTouch)
						teleportMaid[key .. "_onTouchEnded"] = part.TouchEnded:Connect(onTouch)
					end
				end

				teleportMaid["_onTouchedRegionHome"] = model.Home.Touched:Connect(function(hit)
					onTouchRegion(hit, model.Home)
				end)
				teleportMaid["_onTouchedRegionHome"] = model.Home.TouchEnded:Connect(function(hit)
					onTouchRegion(hit, model.Home)
				end)
				for _, hit in next, model.Home:GetTouchingParts() do
					onTouchRegion(hit, model.Home)
				end

				teleportMaid["_onTouchedRegionAway"] = model.Away.Touched:Connect(function(hit)
					onTouchRegion(hit, model.Away)
				end)
				teleportMaid["_onTouchedRegionAway"] = model.Away.TouchEnded:Connect(function(hit)
					onTouchRegion(hit, model.Away)
				end)
				for _, hit in next, model.Away:GetTouchingParts() do
					onTouchRegion(hit, model.Away)
