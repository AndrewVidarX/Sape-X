			local attachment0 = Instance.new("Attachment", part)
			attachment0.WorldPosition = position + Vector3.new(0, 200, 0)

			local attachment1 = Instance.new("Attachment", part)
			attachment1.WorldPosition = position

			local newBolt = lightningBolt.new(attachment0, attachment1, 16)
			newBolt.AnimationSpeed = 20
			newBolt.PulseSpeed = 10
			newBolt.PulseLength = 10
			newBolt.FadeLength = 0.25
			newBolt.Color = Color3.fromRGB(255, 221, 221)

			local newSparks = lightningSparks.new(newBolt)
			local newExplosion = lightningExplosion.new(position, 0.1, 10, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))

			if (part.Position - (workspace.CurrentCamera.CFrame.Position * Vector3.new(1, 0, 1))).Magnitude <= 85 then
				sounds:load({
					directory = part,
					soundId = references.Main.sounds.Weather.Thunder["Lightning Close"].SoundId,
					rollOffMaxDistance = 500000,
					rollOffMinDistance = 50,
					volume = 1,
					play = true
				})
			else
				sounds:load({
					directory = part,
					soundId = references.Main.sounds.Weather.Thunder["Lightning Far"].SoundId,
					rollOffMaxDistance = 50000,
					rollOffMinDistance = 50,
					volume = 1,
					play = true
				})
			end

			task.delay(0.2, function()
				newBolt:Destroy()
				newSparks:Destroy()
				newExplosion:Destroy()
			end)

			task.delay(5, function()
				part:Destroy()
				services.TweenService:Create(burn.SurfaceGui.ImageLabel, TweenInfo.new(10, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {ImageTransparency = 1}):Play()
				task.wait(10)
				burn:Destroy()
			end)
		end,

		["levelUp"] = function(level)
			if not levelUpDebounce then
				levelUpDebounce = true
				references.Main.sounds.UI.Swipe:Play()

				playerGui.main.levelUp.Visible = true
				playerGui.main.levelUp.level.TextTransparency = 1
				playerGui.main.levelUp.level.Text = tostring(level)
				playerGui.main.levelUp.level.Position = UDim2.new(0.5, 0, 1, 10)
				playerGui.main.levelUp.label.Position = UDim2.new(0.5, -20, 0, 0)

				_G._services.TweenService:Create(playerGui.main.levelUp.label, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = UDim2.new(0.5, 0, 0, 0)}):Play()
				_G._services.TweenService:Create(playerGui.main.levelUp.label.UIGradient, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(1, 0)}):Play()
				task.wait(0.25)
				
				_G._services.TweenService:Create(playerGui.main.levelUp.level, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 0, Position = UDim2.new(0.5, 0, 1, -10)}):Play()
				task.wait(3)
				
				_G._services.TweenService:Create(playerGui.main.levelUp.level, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 1, Position = UDim2.new(0.5, 0, 1, 10)}):Play()
				task.wait(0.25)
				
				_G._services.TweenService:Create(playerGui.main.levelUp.label, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 1}):Play()
				task.wait(0.25)
				
				playerGui.main.levelUp.level.TextTransparency = 0
				playerGui.main.levelUp.level.Position = UDim2.new(0.5, 0, 1, -10)
				playerGui.main.levelUp.label.Position = UDim2.new(0.5, 0, 0, 0)
				playerGui.main.levelUp.label.TextTransparency = 0
				playerGui.main.levelUp.label.UIGradient.Offset = Vector2.new(-1, 0)
				playerGui.main.levelUp.Visible = false
				levelUpDebounce = false
			end
		end,
		
		["message"] = function(message, lifeTime)
			if not messageDebounce then
				messageDebounce = true
				playerGui.main.message.label.Text = message
				playerGui.main.message.label.UIGradient.Rotation = 0
				playerGui.main.message.label.UIGradient.Offset = Vector2.new(-1, 0)
				playerGui.main.message.label.Size = UDim2.new(0, playerGui.main.message.AbsoluteSize.X, 0, playerGui.main.message.AbsoluteSize.Y)

				_G._services.TweenService:Create(playerGui.main.message.label.UIGradient, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(1, 0)}):Play()

				task.wait(lifeTime or 3.5)
				playerGui.main.message.label.UIGradient.Offset = Vector2.new(-1, 0)
				playerGui.main.message.label.UIGradient.Rotation = 180
				_G._services.TweenService:Create(playerGui.main.message.label.UIGradient, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(1, 0)}):Play()

				task.wait(0.6)
				playerGui.main.message.label.UIGradient.Offset = Vector2.new(-1, 0)
				playerGui.main.message.label.UIGradient.Rotation = 0
				messageDebounce = false
			end
		end,
		
		["takePrompt"] = function(folder)
			if not takePrompts[folder.Name] and not references.Main.cards.red:FindFirstChild(localPlayer.Name) then
				local class = take.new(folder)
				takePrompts[folder.Name] = class
			end
		end,
		
		["takeClear"] = function(key)
			if takePrompts[key] then
				takePrompts[key]:clear()
				takePrompts[key] = nil
			end
		end,
		
		["bindMovement"] = function(status)
			if status == "freeze" then
				local controls = playerModuleScript:GetControls()
				
				if controls then
					controls:Disable()
				end
				
				localPlayer.Character:SetAttribute("freezeMovement", true)
				_G._services.ContextActionService:BindAction(
					freezeMovement,
					function() return Enum.ContextActionResult.Sink end,
					false,
					unpack(Enum.PlayerActions:GetEnumItems())
				)
			else
				local controls = playerModuleScript:GetControls()

				if controls then
					controls:Enable()
				end
				
				localPlayer.Character:SetAttribute("freezeMovement", nil)
				_G._services.ContextActionService:UnbindAction(freezeMovement)
			end
		end,
		
		["moveTo"] = function(position)
			local localMaid = maidClass.new()
			
			localPlayer.Character.Humanoid:SetAttribute("moveTo", true)
			localPlayer.Character.Humanoid:MoveTo(position)
			
			localMaid["moveToFinished"] = localPlayer.Character.Humanoid.MoveToFinished:Connect(function(reached)
				if reached == true then
					localMaid:DoCleaning()
					return true
				end
			end)
			
			for index = 1, 10 do
				if not localMaid["moveToFinished"] then
					break
				end
				
				task.wait(0.5)
			end
			
			if localMaid["moveToFinished"] then
				localMaid:DoCleaning()
				return true
			end
		end,

		["trip"] = function()
			clientEngine:SetAttribute("Ragdoll", true)
			task.wait(math.random(1.5, 3))
			clientEngine:SetAttribute("Ragdoll", false)
		end,

		["pull"] = function()
			movementController:SetAttribute("canSprint", false)
			localPlayer.Character.Humanoid.WalkSpeed = services.StarterPlayer.CharacterWalkSpeed - 5

			task.wait(math.random(2, 3))

			movementController:SetAttribute("canSprint", true)
			localPlayer.Character.Humanoid.WalkSpeed = services.StarterPlayer.CharacterWalkSpeed
		end,

		["ragdoll"] = function()
			clientEngine:SetAttribute("Ragdoll", true)
		end,

		["unragdoll"] = function()
			clientEngine:SetAttribute("Ragdoll", false)
		end,
		
		["handshake"] = function(cipher)	
			local sizes = {}
			for i, limb in pairs(localPlayer.Character:GetChildren()) do
				if limb:IsA("BasePart") then
					for i, v in pairs(limbs) do
						if string.match(limb.Name, v) then
							local dictionaryVector = {limb.Size.X, limb.Size.Y, limb.Size.Z}
							sizes[limb.Name] = dictionaryVector
						end
					end
				end
			end
			if localPlayer.Character.Parent ~= workspace then
				sizes = nil
			end
			return services.HttpService:JSONEncode({
				key = cipher,
				WalkSpeed = localPlayer.Character.Humanoid.WalkSpeed,
				limbSizes = sizes
			})
		end,
	}
	
	for index, value in next, tasks do
		network:add(index, value)
	end
end

return config
