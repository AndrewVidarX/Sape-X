		["replay"] = function(preset, side, speed)
			doTransition()
			
			local referee = workspace.game.referee
			local rootCFrame = localPlayer.Character.PrimaryPart.CFrame
			local serverFolder = ballUtil.GetServerBallFolder()
			local characters = {}
			local spawns = {}
			local balls = {}
			
			for _, part in next, workspace.spawns.spawn:GetChildren() do
				if part and part.Name == "spawn" then
					table.insert(spawns, part)
				end
			end
			
			for _, ball in next, ballUtil.GetBalls() do
				if ball then
					balls[ball] = ball.CFrame
					ball.CFrame = workspace.game.holder.Teleport.CFrame
				end
			end
			
			for _, player in next, services.Players:GetPlayers() do
				if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					if not characters[player] then
						characters[player] = {}
					end
					
					for _, part in next, player.Character:GetDescendants() do
						if part and (part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture")) then
							characters[player][part] = part.Transparency
							part.Transparency = 1
						end
					end
				end
			end
			
			network:send("partTeleport", spawns[math.random(1, #spawns)], CFrame.new(0, 3.5, 0))
			referee.Parent = _G._references.Main
			
			playerGui.main.Enabled = false
			references.Main.fans.Cheer.Value = false
			
			local replayValue = Instance.new("StringValue")
			replayValue.Name = "play"
			replayValue.Value = preset
			replayValue:SetAttribute("side", side)
			replayValue:SetAttribute("speed", speed)
			replayValue.Parent = localPlayer.PlayerScripts.replay
			
			while replayValue.Parent do
				task.wait()
			end
			
			doTransition()
			
			for _, value in next, workspace.game.debug:GetChildren() do
				if value and value.Name == localPlayer.Name and value:IsA("BoolValue") and value:GetAttribute("replay") then
					value:Destroy()
				end
			end
			
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
			workspace.CurrentCamera.FieldOfView = tonumber(references.Profile.settings.Visual["Field of View"].Value)
			references.Main.fans.Cheer.Value = false
			
			for ball, cframe in next, balls do
				if ball and cframe then
					ball.CFrame = cframe
					ball.Anchored = false
					ball:SetAttribute("replay", nil)
					ball:SetAttribute("netHit", nil)
					
					if ball:FindFirstChild("replication") and ball.replication:FindFirstChild("AssemblyLinearVelocity") then
						ball.replication.AssemblyLinearVelocity.Value = Vector3.zero
					end
				end
			end
			
			for _, player in next, services.Players:GetPlayers() do
				if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and characters[player] then
					for part, transparency in next, characters[player] do
						if part and transparency then
							part.Transparency = transparency
						end
					end
				end
			end
			
			referee.Parent = workspace.game
			localPlayer.Character:SetPrimaryPartCFrame(rootCFrame)
			playerGui.main.Enabled = true
			_G._services.StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
		end,
		
