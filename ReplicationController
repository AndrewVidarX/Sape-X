					workspace.CurrentCamera.FieldOfView  = tonumber(folder.cutsceneSettings.CameraFieldOfView.Value)
					if not folder.special:FindFirstChild(args.Name) then
						workspace.CurrentCamera.CFrame = CFrame.lookAt(angle1.CFrame.Position, folder.cutsceneSettings.LockOnTarget.Value.CFrame.Position)
					end
